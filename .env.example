# New Orleans -- environment variables. NAMES ONLY. Never a real token,
# id, webhook or secret in this file or in the repo/brain -- CONTRACT.md
# section 11.

# --- Discord bot ---
DISCORD_TOKEN=
GUILD_ID=
SHOP_CHANNEL_ID=
ORDERS_CHANNEL_ID=
ALERTS_CHANNEL_ID=

# Comma-separated Discord role ids. Staff can approve orders and open the
# admin panel; managers is currently a superset alias evaluated alongside
# staff.
STAFF_ROLE_IDS=
MANAGER_ROLE_IDS=

# Comma-separated Discord USER ids. Owners, and only owners, can fund a
# treasury -- that mints coins that did not exist before, so it is a list
# of people, not a role anyone with Manage Roles could hand out.
# Without this NOBODY can put gold into the shop and every payout fails.
OWNER_DISCORD_IDS=

# If true (default), slash commands sync to GUILD_ID only (fast, local
# iteration). If false, syncs globally (slow propagation, all guilds).
COMMAND_SYNC_GUILD_ONLY=true

# --- Provably-fair casino ---
# REQUIRED before the bot can start (core/games.py refuses to boot without
# it -- see docs/casino-seed-secret.md for the full writeup). A persistent,
# private secret used to derive each round's server seed. Must be at least
# 20 characters and must NOT be the placeholder value that used to ship as
# this module's default ("dev-insecure-seed-secret-change-me") -- that
# value is public, it is a literal in core/games.py, and a bet placed under
# it can be predicted by anyone who has read the source.
#
# Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Losing it does not expose past rounds (those already revealed their real
# seed on settlement). Rotating it is safe for rounds that are already
# settled, but voids any round that is still OPEN at the moment you rotate
# it (settle_round can no longer derive that round's committed seed, so it
# refunds the open bets rather than guessing) -- rotate between sessions,
# not while rounds are in flight.
NOLA_GAME_SEED_SECRET=

# --- Website ---
# The site runs as its own process (run_web.py) and is reachable through a
# Cloudflare tunnel. These are read by web/auth.py; without the first three
# the sign-in button does not appear at all and the public pages still work.

# Discord Developer Portal -> your application -> OAuth2.
NOLA_DISCORD_CLIENT_ID=
NOLA_DISCORD_CLIENT_SECRET=

# MUST match a Redirect URI registered in the Developer Portal BYTE FOR BYTE
# -- scheme, host, path, no trailing slash. Behind a Cloudflare tunnel this
# is the PUBLIC https address, never localhost and never the tunnel's own
# internal port:
#   https://<your-domain>/auth/callback
# Discord rejects the callback outright on any mismatch, and the error it
# returns names neither which part differed nor what it expected.
NOLA_DISCORD_REDIRECT_URI=

# Comma-separated Discord USER ids (not role ids) who may open /ledger.
# The website cannot see Discord roles -- it only knows who signed in --
# so web staff is its own list. Distinct from STAFF_ROLE_IDS above.
NOLA_STAFF_DISCORD_IDS=

# Port the site binds locally; the tunnel points at this. PORT wins if both
# are set, because most hosts inject PORT themselves.
NOLA_WEB_PORT=8080

# --- Database ---
# Path to the SQLite file. Defaults to neworleans.db in the project root.
NOLA_DB_PATH=
